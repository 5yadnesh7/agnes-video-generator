# Server-only. Never NEXT_PUBLIC_.
AGNES_API_KEY=
# Story tab only (storyboard chat, character sheets, scene stills). Video create uses AGNES_API_KEY.
AGNES_API_KEY2=
# Optional. OpenAI-style /v1 suffix is ok. Default: https://apihub.agnes-ai.com
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# Vercel: set to the deployment origin, e.g. https://your-app.vercel.app
# PUBLIC_APP_URL=
# Cloudflare R2 — uploads/ vs generated/. Agnes fetches R2_PUBLIC_BASE_URL.
R2_ACCOUNT_ID=
R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=agnes-media
R2_PUBLIC_BASE_URL=https://pub-xxxx.r2.dev
